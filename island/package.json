{
  "name": "todo-app",
  "version": "1.0.0",
  "description": "UI-only ToDoApp React component (TypeScript, Vite lib build).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexlupu2/todo-app.git"
  },
  "bugs": { "url": "https://github.com/alexlupu2/todo-app/issues" },
  "homepage": "https://github.com/alexlupu2/todo-app#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "src/**/*.module.css", "README.md", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "engines": { "node": ">=22" },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.0",
    "axios": "^1.7.0",
    "react-redux": "^9.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^3.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "scripts": {
    "dev": "vite --config dev/vite.config.ts",
    "build": "vite build",
    "preview": "vite preview --config dev/vite.config.ts",
    "typecheck": "tsc --project tsconfig.lib.json"
  },
  "keywords": ["react", "todo", "component", "vite", "typescript"]
}